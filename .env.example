# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- TMDB ---
# https://www.themoviedb.org/settings/api  (use the "API Read Access Token" v4 auth style,
# or the v3 API key — TMDB_API_KEY below is used as the v3 `api_key` query param)
TMDB_API_KEY=

# --- RapidAPI: Streaming Availability (movie-of-the-night) ---
# https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
RAPIDAPI_KEY=
RAPIDAPI_STREAMING_AVAILABILITY_HOST=streaming-availability.p.rapidapi.com

# --- Supabase ---
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, used in API route handlers. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public base URL used to build the QR/join links. Set to your deployed URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
